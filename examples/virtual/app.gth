package main

import (
	"fmt"

	"github.com/metruzanca/gothic"
	"github.com/metruzanca/gothic/dom"
	"github.com/metruzanca/gothic/virtual"
)

const (
	totalRows      = 5000
	rowHeight      = 36
	viewportHeight = 432
	visibleCount   = 12
)

type Row struct {
	ID   int
	Text string
}

type Model struct {
	Items     []Row
	Window    virtual.Window
	RowHeight int
	Height    int
}

type Scrolled struct{ Top int }

func NewModel() Model {
	items := make([]Row, totalRows)
	for i := range items {
		items[i] = Row{ID: i + 1, Text: fmt.Sprintf("Row %d", i+1)}
	}
	m := Model{Items: items, RowHeight: rowHeight, Height: viewportHeight}
	m.Window = virtual.WindowFor(0, m.RowHeight, m.Height, len(m.Items))
	return m
}

func (m Model) Init() gothic.Cmd {
	return nil
}

func (m Model) Update(msg gothic.Msg) (gothic.Model, gothic.Cmd) {
	switch msg := msg.(type) {
	case Scrolled:
		m.Window = virtual.WindowFor(msg.Top, m.RowHeight, m.Height, len(m.Items))
	}
	return m, nil
}

view App(model Model) {
	<main class="app">
		<h1>Virtualized list</h1>
		<p class="range">
			Showing{ " " }{ model.Window.Start + 1 }-{ model.Window.Start + model.Window.Count }{ " " }of{ " " }{ len(model.Items) }
		</p>
		<div class="viewport" onscroll={ Scrolled{Top: event.target.scrollTop} }>
			<div class="spacer" style={ "height:" + dom.Px(model.Window.Top) }></div>
			for _, item := range model.Items[model.Window.Start : model.Window.Start+model.Window.Count] {
				<div class="row" key={ item.ID }>
					<span class="id">{ item.ID }</span>
					<span>{ item.Text }</span>
				</div>
			}
			<div class="spacer" style={ "height:" + dom.Px(model.Window.Bottom) }></div>
		</div>
		<p class="hint">Only the visible rows are in the DOM. Scroll to move the window.</p>
	</main>
}
