package main

//gothic:components github.com/metruzanca/gothic/ui

import (
	"fmt"

	"github.com/metruzanca/gothic"
)

const totalRows = 5000

type RowData struct {
	Title  string
	Detail string
}

type OtherRowData struct {
	Name string
	Meta string
}

type Model struct {
	Rows      []RowData
	OtherRows []OtherRowData
}

func NewModel() Model {
	rows := make([]RowData, totalRows)
	for i := range rows {
		n := i + 1
		rows[i] = RowData{
			Title:  fmt.Sprintf("Row %d", n),
			Detail: fmt.Sprintf("Virtual row %d of %d", n, totalRows),
		}
	}
	other := make([]OtherRowData, 200)
	for i := range other {
		n := i + 1
		detail := fmt.Sprintf("Second list row %d", n)
		if n%3 == 0 {
			detail = detail + " with a longer description that wraps onto another line."
		}
		other[i] = OtherRowData{
			Name: fmt.Sprintf("Item %d", n),
			Meta: detail,
		}
	}
	return Model{Rows: rows, OtherRows: other}
}

func (m Model) Init() gothic.Cmd {
	return nil
}

func (m Model) Update(msg gothic.Msg) (gothic.Model, gothic.Cmd) {
	return m, nil
}

view Row(row RowData) {
	<div class="row-content">
		<strong class="title">{ row.Title }</strong>
		<span class="detail">{ row.Detail }</span>
	</div>
}

view OtherRow(row OtherRowData) {
	<div class="other-row">
		<strong>{ row.Name }</strong>
		<span>{ row.Meta }</span>
	</div>
}

view App(model Model) {
	<main class="app">
		<h1>Virtualized list</h1>
		<p class="hint">5,000 rows with only the visible window in the DOM. Scroll inside the list.</p>
		<ui.VirtualList items={ model.Rows } height={ 432 } rowheight={ 36 } row={ Row } />

		<h2>Second list, different row view</h2>
		<p class="hint">Two lists in one app can use different row types and views.</p>
		<div class="variable-list">
			<ui.VirtualList items={ model.OtherRows } height={ 0 } rowheight={ 0 } row={ OtherRow } />
		</div>
	</main>
}
