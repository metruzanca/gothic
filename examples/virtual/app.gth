package main

import (
	"fmt"

	"github.com/metruzanca/gothic"
	"github.com/metruzanca/gothic/dom"
)

const (
	totalRows    = 5000
	rowHeight    = 36
	visibleCount = 12
)

type Row struct {
	ID   int
	Text string
}

type Model struct {
	Items        []Row
	VisibleItems []Row
	Top          int
	Start        int
	RowHeight    int
	VisibleCount int
	Bottom       int
}

type Scrolled struct{ Top int }

func NewModel() Model {
	items := make([]Row, totalRows)
	for i := range items {
		items[i] = Row{ID: i + 1, Text: fmt.Sprintf("Row %d", i+1)}
	}
	m := Model{Items: items, RowHeight: rowHeight, VisibleCount: visibleCount}
	if m.VisibleCount > len(m.Items) {
		m.VisibleCount = len(m.Items)
	}
	m.VisibleItems = m.Items[:m.VisibleCount]
	m.Bottom = (len(m.Items) - m.VisibleCount) * m.RowHeight
	return m
}

func (m Model) Init() gothic.Cmd {
	return nil
}

func (m Model) Update(msg gothic.Msg) (gothic.Model, gothic.Cmd) {
	switch msg := msg.(type) {
	case Scrolled:
		m.Top = msg.Top - msg.Top%m.RowHeight
		if m.Top < 0 {
			m.Top = 0
		}
		maxTop := (len(m.Items) - m.VisibleCount) * m.RowHeight
		if m.Top > maxTop {
			m.Top = maxTop
		}
		m.Start = m.Top / m.RowHeight
		m.VisibleItems = m.Items[m.Start : m.Start+m.VisibleCount]
		m.Bottom = (len(m.Items) - m.Start - m.VisibleCount) * m.RowHeight
	}
	return m, nil
}

view App(model Model) {
	<main class="app">
		<h1>Virtualized list</h1>
		<p class="range">
			Showing{ " " }{ model.Start + 1 }-{ model.Start + len(model.VisibleItems) }{ " " }of{ " " }{ len(model.Items) }
		</p>
		<div class="viewport" onscroll={ Scrolled{Top: event.target.scrollTop} }>
			<div class="spacer" style={ "height:" + dom.Px(model.Top) }></div>
			for _, item := range model.VisibleItems {
				<div class="row" key={ item.ID }>
					<span class="id">{ item.ID }</span>
					<span>{ item.Text }</span>
				</div>
			}
			<div class="spacer" style={ "height:" + dom.Px(model.Bottom) }></div>
		</div>
		<p class="hint">Only the visible rows are in the DOM. Scroll to move the window.</p>
	</main>
}
