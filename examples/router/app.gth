package main

import (
	"github.com/metruzanca/gothic"
	"github.com/metruzanca/gothic/js"
	"github.com/metruzanca/gothic/route"
)

type Model struct {
	Path     string
	Page     string
	Name     string
	Draft    string
	LastPath string
}

func NewModel(path string) Model {
	m := Model{Path: path}
	switch path {
	case "/":
		m.Page = "home"
	case "/about":
		m.Page = "about"
	case "/settings":
		m.Page = "settings"
	default:
		params := route.Params("/hello/:name", path)
		if params != nil {
			m.Page = "hello"
			m.Name = params["name"]
			m.Draft = m.Name
		} else {
			m.Page = "notfound"
		}
	}
	return m
}

type LocationChanged struct {
	Path  string
	Query string
	Hash  string
}

type GoSettings struct{}
type GoBack struct{}

type NameChanged struct {
	Name string
}

type SayHello struct{}

func (m Model) Init() gothic.Cmd {
	return nil
}

func (m Model) Update(msg gothic.Msg) (gothic.Model, gothic.Cmd) {
	switch msg := msg.(type) {
	case LocationChanged:
		m.Path = msg.Path
		m.Name = ""
		switch msg.Path {
		case "/":
			m.Page = "home"
		case "/about":
			m.Page = "about"
		case "/settings":
			m.Page = "settings"
		default:
			params := route.Params("/hello/:name", msg.Path)
			if params != nil {
				m.Page = "hello"
				m.Name = params["name"]
				m.Draft = m.Name
			} else {
				m.Page = "notfound"
			}
		}
		m.LastPath = js.GetItem("lastPath")
		js.SetItem("lastPath", msg.Path)
		js.SetTitle("gothic router: " + m.Page)
	case GoSettings:
		return m, func() gothic.Msg {
			js.Navigate("/settings")
			return nil
		}
	case GoBack:
		return m, func() gothic.Msg {
			js.Back()
			return nil
		}
	case NameChanged:
		m.Draft = msg.Name
	case SayHello:
		name := m.Draft
		if name == "" {
			return m, nil
		}
		return m, func() gothic.Msg {
			js.Navigate("/hello/" + name)
			return nil
		}
	}
	return m, nil
}

view App(model Model) {
	<main class="page">
		<nav class="nav">
			<a href="/" route class:active={ model.Page == "home" }>Home</a>
			<a href="/about" route class:active={ model.Page == "about" }>About</a>
			<a href="/settings" route class:active={ model.Page == "settings" }>Settings</a>
			<a href="/hello/Ada" route class:active={ model.Page == "hello" }>Hello</a>
		</nav>

		if model.Page == "home" {
			<section>
				<h1>Home</h1>
				<p>This is the home page. Click a link and watch the URL change without a reload.</p>
			</section>
		}
		if model.Page == "about" {
			<section>
				<h1>About</h1>
				<p>The server rendered this deep link from the request path before hydration.</p>
			</section>
		}
		if model.Page == "settings" {
			<section>
				<h1>Settings</h1>
				<p>This page was reached through a command that called js.Navigate.</p>
			</section>
		}
		if model.Page == "hello" {
			<section>
				<h1>Hello,{ " " }{ model.Name }</h1>
				<p>The name came from the /hello/:name path parameter.</p>
				<div class="say-hello">
					<label for="hello-name">Say hello to</label>
					<input id="hello-name" value={ model.Draft } placeholder="A name" oninput={ NameChanged{Name: event.target.value} } />
					<button onclick={ SayHello{} }>Say hello</button>
				</div>
			</section>
		}
		if model.Page == "notfound" {
			<section>
				<h1>Not found</h1>
				<p>No route for{ " " }{ model.Path }.</p>
			</section>
		}

		<div class="row">
			<button onclick={ GoSettings{} }>Open settings</button>
			<button onclick={ GoBack{} }>Back</button>
		</div>

		<p class="meta">Current path:{ " " }{ model.Path }</p>
		<p class="meta">Name:{ " " }{ model.Name }</p>
		<p class="meta">Last path:{ " " }{ model.LastPath }</p>
	</main>
}
