package main

import (
	"github.com/metruzanca/gothic"
	"github.com/metruzanca/gothic/js"
)

type Model struct {
	Path     string
	Page     string
	LastPath string
}

func NewModel(path string) Model {
	m := Model{Path: path}
	switch path {
	case "/":
		m.Page = "home"
	case "/about":
		m.Page = "about"
	case "/settings":
		m.Page = "settings"
	default:
		m.Page = "notfound"
	}
	return m
}

type LocationChanged struct {
	Path  string
	Query string
	Hash  string
}

type GoSettings struct{}
type GoBack struct{}

func (m Model) Init() gothic.Cmd {
	return nil
}

func (m Model) Update(msg gothic.Msg) (gothic.Model, gothic.Cmd) {
	switch msg := msg.(type) {
	case LocationChanged:
		m.Path = msg.Path
		m.Page = "notfound"
		if msg.Path == "/" {
			m.Page = "home"
		}
		if msg.Path == "/about" {
			m.Page = "about"
		}
		if msg.Path == "/settings" {
			m.Page = "settings"
		}
		m.LastPath = js.GetItem("lastPath")
		js.SetItem("lastPath", msg.Path)
		js.SetTitle("gothic router: " + m.Page)
	case GoSettings:
		return m, func() gothic.Msg {
			js.Navigate("/settings")
			return nil
		}
	case GoBack:
		return m, func() gothic.Msg {
			js.Back()
			return nil
		}
	}
	return m, nil
}

view App(model Model) {
	<main class="page">
		<nav class="nav">
			<a href="/" route class:active={ model.Page == "home" }>Home</a>
			<a href="/about" route class:active={ model.Page == "about" }>About</a>
			<a href="/settings" route class:active={ model.Page == "settings" }>Settings</a>
		</nav>

		if model.Page == "home" {
			<section>
				<h1>Home</h1>
				<p>This is the home page. Click a link and watch the URL change without a reload.</p>
			</section>
		}
		if model.Page == "about" {
			<section>
				<h1>About</h1>
				<p>The server rendered this deep link from the request path before hydration.</p>
			</section>
		}
		if model.Page == "settings" {
			<section>
				<h1>Settings</h1>
				<p>This page was reached through a command that called js.Navigate.</p>
			</section>
		}
		if model.Page == "notfound" {
			<section>
				<h1>Not found</h1>
				<p>No route for{ " " }{ model.Path }.</p>
			</section>
		}

		<div class="row">
			<button onclick={ GoSettings{} }>Open settings</button>
			<button onclick={ GoBack{} }>Back</button>
		</div>

		<p class="meta">Current path:{ " " }{ model.Path }</p>
		<p class="meta">Last path:{ " " }{ model.LastPath }</p>
	</main>
}
