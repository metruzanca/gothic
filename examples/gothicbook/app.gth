package main

//gothic:components github.com/metruzanca/gothic/ui

import (
	"context"
	"strings"

	"github.com/metruzanca/gothic"
	"github.com/metruzanca/gothic/dom"
	"github.com/metruzanca/gothic/ui"
)

type TabEntry struct {
	ID    string
	Label string
	Panel string
}

type AccordionEntry struct {
	ID    string
	Title string
	Body  string
}

type Model struct {
	Path          string
	Page          string
	Wordmark      string
	Count         int
	Error         string
	Name          string
	NameError     string
	Done          bool
	Notify        bool
	Tabs          []TabEntry
	ActiveTab     string
	Accordion     []AccordionEntry
	OpenAccordion string
	Fruits            []ui.ComboboxItem
	FruitValue        string
	FruitLabel        string
	FruitValues       []string
	FruitValueLabels  []string
}

type LocationChanged struct {
	Path  string
	Query string
	Hash  string
}

type IncrementClicked struct{}
type CountLoaded struct{ Count int }
type CountFailed struct{ Message string }
type NameChanged struct{ Text string }
type DoneChanged struct{}
type NotifyChanged struct{}
type TabClicked struct{ ID string }
type TabKey struct{ Key string }
type AccordionClicked struct{ ID string }

type Procedures interface {
	gothic.RPCService
	Increment(ctx context.Context) (int, error)
}

func NewModelAt(path string, count int) Model {
	m := Model{
		Path:          path,
		Page:          pageForPath(path),
		Wordmark:      wordmarkHref,
		Count:         count,
		Name:          "Ada",
		ActiveTab:     "profile",
		OpenAccordion: "one",
		FruitValue:       "banana",
		FruitLabel:       "Banana",
		FruitValues:      []string{"apple", "fig"},
		FruitValueLabels: []string{"Apple", "Fig"},
		Tabs: []TabEntry{
			{ID: "profile", Label: "Profile", Panel: "Profile settings. The App owns the active tab."},
			{ID: "notifications", Label: "Notifications", Panel: "Notification settings. Keyboard navigation is handled with onkeynav."},
			{ID: "billing", Label: "Billing", Panel: "Billing settings. Panels are controlled pure components."},
		},
		Accordion: []AccordionEntry{
			{ID: "one", Title: "What is gothic?", Body: "A fullstack Go framework with server rendering and a compiled client runtime."},
			{ID: "two", Title: "How does state work?", Body: "The App owns the model. Components send typed messages back to Update."},
			{ID: "three", Title: "Why no CSS?", Body: "The UI kit ships markup and behavior. You own the styling through data-part and data attributes."},
		},
		Fruits: []ui.ComboboxItem{
			{Value: "apple", Label: "Apple"},
			{Value: "banana", Label: "Banana"},
			{Value: "cherry", Label: "Cherry"},
			{Value: "dragonfruit", Label: "Dragon fruit"},
			{Value: "elderberry", Label: "Elderberry"},
			{Value: "fig", Label: "Fig"},
			{Value: "grape", Label: "Grape"},
		},
	}
	return m
}

func pageForPath(path string) string {
	switch path {
	case "/":
		return "overview"
	case "/button":
		return "button"
	case "/field":
		return "field"
	case "/tabs":
		return "tabs"
	case "/accordion":
		return "accordion"
	case "/combobox":
		return "combobox"
	default:
		return "notfound"
	}
}

func (m Model) Init() gothic.Cmd {
	return nil
}

func (m Model) Update(msg gothic.Msg) (gothic.Model, gothic.Cmd) {
	switch msg := msg.(type) {
	case LocationChanged:
		m.Path = msg.Path
		m.Page = "notfound"
		switch msg.Path {
		case "/":
			m.Page = "overview"
		case "/button":
			m.Page = "button"
		case "/field":
			m.Page = "field"
		case "/tabs":
			m.Page = "tabs"
		case "/accordion":
			m.Page = "accordion"
		case "/combobox":
			m.Page = "combobox"
		}
	case IncrementClicked:
		return m, func() gothic.Msg {
			count, err := Increment()
			if err != nil {
				return CountFailed{Message: err.Error()}
			}
			return CountLoaded{Count: count}
		}
	case CountLoaded:
		m.Count = msg.Count
		m.Error = ""
	case CountFailed:
		m.Error = msg.Message
	case NameChanged:
		m.Name = msg.Text
		if strings.TrimSpace(msg.Text) == "" {
			m.NameError = "Enter your name."
		} else {
			m.NameError = ""
		}
	case DoneChanged:
		m.Done = !m.Done
	case NotifyChanged:
		m.Notify = !m.Notify
	case TabClicked:
		m.ActiveTab = msg.ID
	case TabKey:
		index := 0
		for i, tab := range m.Tabs {
			if tab.ID == m.ActiveTab {
				index = i
			}
		}
		if msg.Key == "ArrowRight" {
			index = (index + 1) % len(m.Tabs)
		} else if msg.Key == "ArrowLeft" {
			index = (index - 1 + len(m.Tabs)) % len(m.Tabs)
		} else if msg.Key == "Home" {
			index = 0
		} else if msg.Key == "End" {
			index = len(m.Tabs) - 1
		}
		m.ActiveTab = m.Tabs[index].ID
	case AccordionClicked:
		if m.OpenAccordion == msg.ID {
			m.OpenAccordion = ""
		} else {
			m.OpenAccordion = msg.ID
		}
	case ui.ComboboxValueChanged:
		m.FruitValue = msg.Value
		m.FruitLabel = msg.Label
	case ui.ComboboxValuesChanged:
		m.FruitValues = msg.Values
		m.FruitValueLabels = msg.Labels
	}
	return m, nil
}

view App(model Model) {
	<div class="shell">
		<aside class="sidebar">
			<a class="brand" href="/" route>
				<img src={ model.Wordmark } alt="Gothic" />
				<span class="brand-book">book</span>
			</a>
			<nav class="nav">
				<a class="nav-link" href="/" route class:active={ model.Page == "overview" }>Overview</a>
				<p class="nav-group">Primitives</p>
				<a class="nav-link" href="/button" route class:active={ model.Page == "button" }>Button</a>
				<a class="nav-link" href="/field" route class:active={ model.Page == "field" }>Field</a>
				<a class="nav-link" href="/tabs" route class:active={ model.Page == "tabs" }>Tabs</a>
				<a class="nav-link" href="/accordion" route class:active={ model.Page == "accordion" }>Accordion</a>
				<a class="nav-link" href="/combobox" route class:active={ model.Page == "combobox" }>Combobox</a>
			</nav>
			<div class="sidebar-footer">
				<button class="theme-toggle" type="button" data-theme-toggle>
					<span class="theme-label theme-label-dark">Dark</span>
					<span class="theme-label theme-label-light">Light</span>
				</button>
			</div>
		</aside>

		<main class="content">
			<div class="content-inner">
				if model.Page == "overview" {
					<header class="hero">
						<p class="eyebrow">ui kit</p>
						<h1>A headless design system for gothic</h1>
						<p>Primitives ship markup and behavior. You own the styles through data-part and data attributes.</p>
					</header>
					<div class="tiles">
						<a class="tile" href="/button" route><strong>Button</strong><span>Native buttons with app-owned actions.</span></a>
						<a class="tile" href="/field" route><strong>Field</strong><span>Labels, descriptions, errors, and children.</span></a>
						<a class="tile" href="/tabs" route><strong>Tabs</strong><span>Compound parts with app-owned state.</span></a>
						<a class="tile" href="/accordion" route><strong>Accordion</strong><span>Compound disclosure parts.</span></a>
						<a class="tile" href="/combobox" route><strong>Combobox</strong><span>Filtering, keyboard navigation, and typed messages.</span></a>
					</div>
				}

				if model.Page == "button" {
					<header class="page-head"><p class="eyebrow">primitive</p><h1>Button</h1></header>
					<div class="row">
						<ui.Button variant={ dom.Ptr("primary") } onclick={ IncrementClicked{} }>Increment on the server</ui.Button>
						<ui.Button onclick={ nil }>Secondary</ui.Button>
						<ui.Button disabled={ dom.BoolPtr(true) } onclick={ nil }>Disabled</ui.Button>
					</div>
					<p class="server-count">Server count:{ " " }{ model.Count }</p>
					if model.Error != "" { <p class="error">{ model.Error }</p> }
				}

				if model.Page == "field" {
					<header class="page-head"><p class="eyebrow">primitive</p><h1>Field</h1></header>
					<ui.Field
						id="name"
						label="Your name"
						description={ dom.Ptr("The label and description are linked by id.") }
						error={ dom.Ptr(model.NameError) }
						invalid={ dom.BoolPtr(model.NameError != "") }
						required={ dom.BoolPtr(true) }
					>
						<input class="field-input" id="name" value={ model.Name } oninput={ NameChanged{Text: event.target.value} } />
					</ui.Field>
					<div class="stack">
						<ui.Checkbox id="done" checked={ model.Done } onchange={ DoneChanged{} }>Done</ui.Checkbox>
						<ui.Switch id="notify" checked={ model.Notify } onchange={ NotifyChanged{} }>Notify me</ui.Switch>
					</div>
					<p class="server-count">Done: { model.Done } Notify: { model.Notify }</p>
				}

				if model.Page == "tabs" {
					<header class="page-head"><p class="eyebrow">primitive</p><h1>Tabs</h1></header>
					<ui.Tabs>
						<ui.TabsList label={ dom.Ptr("Account settings") } onkeynav={ TabKey{Key: event.key} }>
							for i, tab := range model.Tabs {
								<ui.TabsTrigger
									id={ dom.ID("settings-tab", i) }
									controls={ dom.Ptr(dom.ID("settings-panel", i)) }
									active={ model.ActiveTab == tab.ID }
									onclick={ TabClicked{ID: tab.ID} }
								>{ tab.Label }</ui.TabsTrigger>
							}
						</ui.TabsList>
						for i, tab := range model.Tabs {
							<ui.TabsPanel
								id={ dom.ID("settings-panel", i) }
								labelledby={ dom.Ptr(dom.ID("settings-tab", i)) }
								active={ model.ActiveTab == tab.ID }
							>{ tab.Panel }</ui.TabsPanel>
						}
					</ui.Tabs>
				}

				if model.Page == "accordion" {
					<header class="page-head"><p class="eyebrow">primitive</p><h1>Accordion</h1></header>
					<ui.Accordion>
						for i, item := range model.Accordion {
							<ui.AccordionItem open={ model.OpenAccordion == item.ID }>
								<ui.AccordionTrigger
									id={ dom.ID("accordion-trigger", i) }
									controls={ dom.Ptr(dom.ID("accordion-panel", i)) }
									expanded={ model.OpenAccordion == item.ID }
									onclick={ AccordionClicked{ID: item.ID} }
								>{ item.Title }</ui.AccordionTrigger>
								<ui.AccordionPanel
									id={ dom.ID("accordion-panel", i) }
									labelledby={ dom.Ptr(dom.ID("accordion-trigger", i)) }
									expanded={ model.OpenAccordion == item.ID }
								>{ item.Body }</ui.AccordionPanel>
							</ui.AccordionItem>
						}
					</ui.Accordion>
				}

				if model.Page == "combobox" {
					<header class="page-head"><p class="eyebrow">primitive</p><h1>Combobox</h1></header>
					<ui.Combobox
						id="fruit"
						items={ model.Fruits }
						fieldlabel={ dom.Ptr("Fruit") }
						value={ dom.Ptr(model.FruitValue) }
						label={ dom.Ptr(model.FruitLabel) }
						values={ nil }
						placeholder={ dom.Ptr("Pick a fruit") }
						name={ dom.Ptr("fruit") }
						clearable={ dom.BoolPtr(true) }
						clearLabel={ dom.Ptr("Clear fruit") }
					/>
					<p class="server-count">Selected: { model.FruitLabel } ({ model.FruitValue })</p>

					<h2>Multiple</h2>
					<ui.Combobox
						id="fruits-multi"
						items={ model.Fruits }
						fieldlabel={ dom.Ptr("Favourite fruits") }
						values={ model.FruitValues }
						multiple={ dom.BoolPtr(true) }
						placeholder={ dom.Ptr("Pick several fruits") }
						name={ dom.Ptr("fruits") }
						clearable={ dom.BoolPtr(true) }
						clearLabel={ dom.Ptr("Clear fruits") }
					/>
				}

				if model.Page == "notfound" {
					<header class="page-head"><p class="eyebrow">404</p><h1>Not found</h1></header>
					<p>No page matches { model.Path }.</p>
				}
			</div>
		</main>
	</div>
}
