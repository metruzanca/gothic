package ui

import (
	"github.com/metruzanca/gothic"
	"github.com/metruzanca/gothic/dom"
)

type TabsProps struct {
	gothic.Children
}

type TabsListProps struct {
	gothic.Children
	Label    *string
	Onkeynav gothic.Msg
}

type TabsTriggerProps struct {
	gothic.Children
	ID       string
	Controls *string
	Active   bool
	Onclick  gothic.Msg
}

type TabsPanelProps struct {
	gothic.Children
	ID         string
	LabelledBy *string
	Active     bool
}

view Tabs(props TabsProps) {
	<div data-part="tabs">{ props.Children }</div>
}

view TabsList(props TabsListProps) {
	<div
		data-part="tabs-list"
		role="tablist"
		aria-label={ dom.Str(props.Label) }
		onkeynav={ props.Onkeynav }
	>{ props.Children }</div>
}

view TabsTrigger(props TabsTriggerProps) {
	<button
		data-part="tabs-trigger"
		data-active={ dom.If(props.Active, "true", "") }
		type="button"
		role="tab"
		id={ props.ID }
		aria-selected={ dom.If(props.Active, "true", "false") }
		aria-controls={ dom.Str(props.Controls) }
		tabindex={ dom.If(props.Active, "0", "-1") }
		onclick={ props.Onclick }
	>{ props.Children }</button>
}

view TabsPanel(props TabsPanelProps) {
	<div
		data-part="tabs-panel"
		data-active={ dom.If(props.Active, "true", "") }
		role="tabpanel"
		id={ props.ID }
		aria-labelledby={ dom.Str(props.LabelledBy) }
		hidden={ !props.Active }
	>{ props.Children }</div>
}
