package ui

import (
	"strings"

	"github.com/metruzanca/gothic"
	"github.com/metruzanca/gothic/dom"
)

type ComboboxItem struct {
	Value string
	Label string
}

type ComboboxProps struct {
	ID          string
	Items       []ComboboxItem
	FieldLabel  *string
	Value       *string
	Label       *string
	Values      []string
	Multiple    *bool
	AriaLabel   *string
	Placeholder *string
	EmptyText   *string
	Name        *string
	Disabled    *bool
	Required    *bool
	Invalid     *bool
	Clearable   *bool
	ClearLabel  *string
}

type ComboboxModel struct {
	Query       string
	Value       string
	Label       string
	Multi       bool
	Selected    []ComboboxItem
	SelectedSet map[string]bool
	Open        bool
	Active      int
	Hovered     int
	Visible     []ComboboxItem
}

type ComboboxValueChanged struct {
	ID    string
	Value string
	Label string
}

type ComboboxValuesChanged struct {
	ID     string
	Values []string
	Labels []string
}

type ComboboxInput struct{ Text string }
type ComboboxKey struct{ Key string }
type ComboboxSelected struct{ Index int }
type ComboboxRemove struct{ Value string }
type ComboboxHovered struct{ Index int }
type ComboboxUnhovered struct{ Index int }
type ComboboxOpened struct{}
type ComboboxClosed struct{}
type ComboboxCleared struct{}

func (m ComboboxModel) Init() gothic.Cmd { return nil }

func (m ComboboxModel) Update(msg gothic.Msg, props ComboboxProps) (ComboboxModel, gothic.Cmd) {
	switch msg := msg.(type) {
	case gothic.PropsChanged:
		if msg.Initial {
			m.Multi = props.Multiple != nil && *props.Multiple
			m.Hovered = -1
			m.Visible = props.Items
			m.Active = 0
			m.SelectedSet = map[string]bool{}
			if m.Multi {
				for _, item := range props.Items {
					for _, value := range props.Values {
						if item.Value == value {
							m.Selected = append(m.Selected, item)
							m.SelectedSet[item.Value] = true
						}
					}
				}
			} else {
				if props.Value != nil {
					m.Value = *props.Value
					m.SelectedSet[m.Value] = true
				}
				if props.Label != nil {
					m.Label = *props.Label
				}
				m.Query = m.Label
				if m.Query == "" {
					m.Query = m.Value
				}
			}
		}
	case ComboboxInput:
		m.Query = msg.Text
		m.Open = true
		m.Visible = nil
		query := strings.ToLower(strings.TrimSpace(msg.Text))
		for _, item := range props.Items {
			if query == "" || strings.Contains(strings.ToLower(item.Label), query) {
				m.Visible = append(m.Visible, item)
			}
		}
		m.Active = 0
	case ComboboxOpened:
		m.Open = true
		if m.Multi {
			m.Query = ""
		} else if m.Query == m.Label {
			m.Query = ""
		}
		m.Visible = props.Items
		m.Active = 0
	case ComboboxClosed:
		m.Open = false
		if m.Multi {
			m.Query = ""
		} else {
			m.Query = m.Label
		}
	case ComboboxHovered:
		if msg.Index >= 0 {
			m.Hovered = msg.Index
			m.Active = msg.Index
		}
	case ComboboxUnhovered:
		if m.Hovered == msg.Index {
			m.Hovered = -1
		}
	case ComboboxKey:
		if !m.Open {
			if msg.Key == "ArrowDown" || msg.Key == "Enter" {
				m.Open = true
				m.Visible = props.Items
				m.Active = 0
			}
			return m, nil
		}
		switch msg.Key {
		case "ArrowDown":
			if len(m.Visible) > 0 {
				m.Active = (m.Active + 1) % len(m.Visible)
			}
		case "ArrowUp":
			if len(m.Visible) > 0 {
				m.Active = (m.Active - 1 + len(m.Visible)) % len(m.Visible)
			}
		case "Home":
			m.Active = 0
		case "End":
			if len(m.Visible) > 0 {
				m.Active = len(m.Visible) - 1
			}
		case "PageDown":
			if len(m.Visible) > 0 {
				m.Active = m.Active + 10
				if m.Active >= len(m.Visible) {
					m.Active = len(m.Visible) - 1
				}
			}
		case "PageUp":
			m.Active = m.Active - 10
			if m.Active < 0 {
				m.Active = 0
			}
		case "Enter":
			if len(m.Visible) > 0 && m.Active >= 0 && m.Active < len(m.Visible) {
				if m.Multi {
					item := m.Visible[m.Active]
					if m.SelectedSet[item.Value] {
						next := []ComboboxItem{}
						for _, selected := range m.Selected {
							if selected.Value != item.Value {
								next = append(next, selected)
							}
						}
						m.Selected = next
						delete(m.SelectedSet, item.Value)
					} else {
						m.Selected = append(m.Selected, item)
						m.SelectedSet[item.Value] = true
					}
					m.Query = ""
					m.Open = true
					m.Visible = props.Items
					m.Active = 0
					values := []string{}
					labels := []string{}
					for _, selected := range m.Selected {
						values = append(values, selected.Value)
						labels = append(labels, selected.Label)
					}
					return m, gothic.Emit(ComboboxValuesChanged{ID: props.ID, Values: values, Labels: labels})
				}
				item := m.Visible[m.Active]
				m.Value = item.Value
				m.Label = item.Label
				m.Query = item.Label
				m.Open = false
				m.SelectedSet = map[string]bool{item.Value: true}
				return m, gothic.Emit(ComboboxValueChanged{ID: props.ID, Value: m.Value, Label: m.Label})
			}
		case "Escape":
			m.Open = false
			if m.Multi {
				m.Query = ""
			} else {
				m.Query = m.Label
			}
		}
	case ComboboxSelected:
		if msg.Index >= 0 && msg.Index < len(m.Visible) {
			if m.Multi {
				item := m.Visible[msg.Index]
				if m.SelectedSet[item.Value] {
					next := []ComboboxItem{}
					for _, selected := range m.Selected {
						if selected.Value != item.Value {
							next = append(next, selected)
						}
					}
					m.Selected = next
					delete(m.SelectedSet, item.Value)
				} else {
					m.Selected = append(m.Selected, item)
					m.SelectedSet[item.Value] = true
				}
				m.Query = ""
				m.Open = true
				m.Visible = props.Items
				m.Active = 0
				values := []string{}
				labels := []string{}
				for _, selected := range m.Selected {
					values = append(values, selected.Value)
					labels = append(labels, selected.Label)
				}
				return m, gothic.Emit(ComboboxValuesChanged{ID: props.ID, Values: values, Labels: labels})
			}
			item := m.Visible[msg.Index]
			m.Value = item.Value
			m.Label = item.Label
			m.Query = item.Label
			m.Open = false
			m.SelectedSet = map[string]bool{item.Value: true}
			return m, gothic.Emit(ComboboxValueChanged{ID: props.ID, Value: m.Value, Label: m.Label})
		}
	case ComboboxRemove:
		next := []ComboboxItem{}
		for _, item := range m.Selected {
			if item.Value != msg.Value {
				next = append(next, item)
			}
		}
		m.Selected = next
		delete(m.SelectedSet, msg.Value)
		values := []string{}
		labels := []string{}
		for _, selected := range m.Selected {
			values = append(values, selected.Value)
			labels = append(labels, selected.Label)
		}
		return m, gothic.Emit(ComboboxValuesChanged{ID: props.ID, Values: values, Labels: labels})
	case ComboboxCleared:
		m.Query = ""
		m.Open = false
		if m.Multi {
			m.Selected = nil
			m.SelectedSet = map[string]bool{}
			return m, gothic.Emit(ComboboxValuesChanged{ID: props.ID})
		}
		m.Value = ""
		m.Label = ""
		m.SelectedSet = map[string]bool{}
		return m, gothic.Emit(ComboboxValueChanged{ID: props.ID, Value: "", Label: ""})
	}
	return m, nil
}

view Combobox(model ComboboxModel, props ComboboxProps) {
	<div
		data-part="combobox"
		data-open={ dom.If(model.Open, "true", "") }
		data-invalid={ dom.If(props.Invalid != nil && *props.Invalid, "true", "") }
		data-multiple={ dom.If(model.Multi, "true", "") }
	>
		if props.FieldLabel != nil {
			<label data-part="combobox-label" for={ props.ID }>{ *props.FieldLabel }</label>
		}
		if model.Multi && len(model.Selected) > 0 {
			<div data-part="combobox-chips">
				for _, item := range model.Selected {
					<span data-part="combobox-chip" key={ item.Value }>
						<span data-part="combobox-chip-label">{ item.Label }</span>
						<button
							data-part="combobox-chip-remove"
							type="button"
							aria-label={ "Remove " + item.Label }
							onclick={ ComboboxRemove{Value: item.Value} }
						>×</button>
					</span>
				}
			</div>
		}
		<div data-part="combobox-control">
			<input
				data-part="combobox-input"
				id={ props.ID }
				role="combobox"
				aria-expanded={ dom.If(model.Open, "true", "false") }
				aria-controls={ props.ID + "-listbox" }
				aria-autocomplete="list"
				aria-activedescendant={ dom.If(model.Open && len(model.Visible) > 0, dom.ID(props.ID + "-option", model.Active), "") }
				aria-label={ dom.Str(props.AriaLabel) }
				aria-invalid={ dom.True(props.Invalid) }
				autocomplete="off"
				placeholder={ dom.Str(props.Placeholder) }
				value={ model.Query }
				disabled={ props.Disabled != nil && *props.Disabled }
				required={ props.Required != nil && *props.Required }
				oninput={ ComboboxInput{Text: event.target.value} }
				onfocus={ ComboboxOpened{} }
				onblur={ ComboboxClosed{} }
				onkeynav={ ComboboxKey{Key: event.key} }
			/>
			if props.Clearable != nil && *props.Clearable && ((model.Multi && len(model.Selected) > 0) || (!model.Multi && model.Value != "")) {
				<button data-part="combobox-clear" type="button" aria-label={ dom.StrOr(props.ClearLabel, "Clear") } onclick={ ComboboxCleared{} }>×</button>
			}
		</div>
		if model.Open {
			<ul data-part="combobox-listbox" id={ props.ID + "-listbox" } role="listbox" aria-multiselectable={ dom.If(model.Multi, "true", "false") }>
				if len(model.Visible) == 0 {
					<li data-part="combobox-empty">{ dom.StrOr(props.EmptyText, "No results") }</li>
				}
				for i, item := range model.Visible {
					<li
						data-part="combobox-option"
						id={ dom.ID(props.ID + "-option", i) }
						role="option"
						aria-selected={ dom.If(model.SelectedSet[item.Value], "true", "false") }
						data-highlighted={ dom.If(i == model.Active, "true", "") }
						data-hovered={ dom.If(i == model.Hovered, "true", "") }
						scroll={ i == model.Active }
						onmouseenter={ ComboboxHovered{Index: i} }
						onmouseleave={ ComboboxUnhovered{Index: i} }
						onmousedown={ ComboboxSelected{Index: i} }
					>{ item.Label }</li>
				}
			</ul>
		}
		if props.Name != nil {
			if model.Multi {
				for _, item := range model.Selected {
					<input type="hidden" name={ *props.Name } value={ item.Value } />
				}
			} else {
				<input type="hidden" name={ *props.Name } value={ model.Value } />
			}
		}
	</div>
}
