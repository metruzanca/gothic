package ui

import (
	"github.com/metruzanca/gothic"
	"github.com/metruzanca/gothic/dom"
)

type FieldProps struct {
	gothic.Children
	ID          string
	Label       string
	Description *string
	Error       *string
	Invalid     *bool
	Required    *bool
	Disabled    *bool
}

view Field(props FieldProps) {
	<div
		data-part="field"
		data-invalid={ dom.If(props.Invalid != nil && *props.Invalid, "true", "") }
		data-required={ dom.If(props.Required != nil && *props.Required, "true", "") }
		data-disabled={ dom.If(props.Disabled != nil && *props.Disabled, "true", "") }
	>
		<label data-part="field-label" for={ props.ID }>{ props.Label }</label>
		if props.Description != nil && *props.Description != "" {
			<p data-part="field-description" id={ props.ID + "-description" }>{ *props.Description }</p>
		}
		{ props.Children }
		if props.Error != nil && *props.Error != "" {
			<p data-part="field-error" id={ props.ID + "-error" }>{ *props.Error }</p>
		}
	</div>
}
