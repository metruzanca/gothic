package ui

import (
	"github.com/metruzanca/gothic"
	"github.com/metruzanca/gothic/dom"
	"github.com/metruzanca/gothic/virtual"
)

type VirtualItem struct {
	ID     int
	Title  string
	Detail string
}

type VirtualListProps struct {
	Items     []VirtualItem
	Height    int
	RowHeight int
}

type VirtualListModel struct {
	Start     int
	Count     int
	Top       int
	Bottom    int
	Height    int
	RowHeight int
}

type VirtualScrolled struct{ Top int }

func NewVirtualListModel(props VirtualListProps) VirtualListModel {
	m := VirtualListModel{Height: 432, RowHeight: 36}
	if props.Height > 0 {
		m.Height = props.Height
	}
	if props.RowHeight > 0 {
		m.RowHeight = props.RowHeight
	}
	win := virtual.WindowFor(0, m.RowHeight, m.Height, len(props.Items))
	m.Start = win.Start
	m.Count = win.Count
	m.Top = win.Top
	m.Bottom = win.Bottom
	return m
}

func (m VirtualListModel) Init() gothic.Cmd {
	return nil
}

func (m VirtualListModel) Update(msg gothic.Msg, props VirtualListProps) (VirtualListModel, gothic.Cmd) {
	switch msg := msg.(type) {
	case VirtualScrolled:
		win := virtual.WindowFor(msg.Top, m.RowHeight, m.Height, len(props.Items))
		m.Start = win.Start
		m.Count = win.Count
		m.Top = win.Top
		m.Bottom = win.Bottom
	case gothic.PropsChanged:
		m.Height = 432
		m.RowHeight = 36
		if props.Height > 0 {
			m.Height = props.Height
		}
		if props.RowHeight > 0 {
			m.RowHeight = props.RowHeight
		}
		win := virtual.WindowFor(m.Top, m.RowHeight, m.Height, len(props.Items))
		m.Start = win.Start
		m.Count = win.Count
		m.Top = win.Top
		m.Bottom = win.Bottom
	}
	return m, nil
}

view VirtualList(model VirtualListModel, props VirtualListProps) {
	<div class="ui-virtual-list" style={ "height:" + dom.Px(model.Height) } onscroll={ VirtualScrolled{Top: event.target.scrollTop} }>
		<div class="ui-virtual-spacer" style={ "height:" + dom.Px(model.Top) }></div>
		for _, item := range props.Items[model.Start : model.Start+model.Count] {
			<div class="ui-virtual-row" key={ item.ID } style={ "height:" + dom.Px(model.RowHeight) }>
				<span class="ui-virtual-title">{ item.Title }</span>
				<span class="ui-virtual-detail">{ item.Detail }</span>
			</div>
		}
		<div class="ui-virtual-spacer" style={ "height:" + dom.Px(model.Bottom) }></div>
	</div>
}
