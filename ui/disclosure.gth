package ui

import "github.com/metruzanca/gothic"

type DisclosureItem struct {
	ID      int
	Title   string
	Details []string
}

type DisclosureProps struct {
	Item DisclosureItem
}

type DisclosureModel struct {
	Expanded bool
	ItemID   int
}

type DisclosureToggled struct{}

func (m DisclosureModel) Init() gothic.Cmd { return nil }

func (m DisclosureModel) Update(msg gothic.Msg, props DisclosureProps) (DisclosureModel, gothic.Cmd) {
	switch msg.(type) {
	case DisclosureToggled:
		m.Expanded = !m.Expanded
		m.ItemID = props.Item.ID
	case gothic.PropsChanged:
		if m.ItemID != props.Item.ID {
			m.Expanded = false
			m.ItemID = props.Item.ID
		}
	}
	return m, nil
}

view Disclosure(model DisclosureModel, props DisclosureProps) {
	<div class="ui-disclosure" class:ui-disclosure-expanded={ model.Expanded }>
		<button class="ui-disclosure-toggle" onclick={ DisclosureToggled{} }>
			{ props.Item.Title }
		</button>
		if model.Expanded {
			<ul class="ui-disclosure-details">
				for _, detail := range props.Item.Details {
					<li>{ detail }</li>
				}
			</ul>
		}
	</div>
}
