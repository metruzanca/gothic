package ui

import "github.com/metruzanca/gothic"

type ButtonModel struct{}

func (m ButtonModel) Init() gothic.Cmd { return nil }

func (m ButtonModel) Update(msg gothic.Msg) (ButtonModel, gothic.Cmd) { return m, nil }

view Button(model ButtonModel, label string, primary bool, onclick gothic.Msg) {
	<button class="ui-button" class:ui-button-primary={ primary } onclick={ emit(onclick) }>{ label }</button>
}
