package ui

import (
	"github.com/metruzanca/gothic"
	"github.com/metruzanca/gothic/dom"
)

type ButtonProps struct {
	gothic.Children
	Type      *string
	Variant   *string
	Disabled  *bool
	AriaLabel *string
	Onclick   gothic.Msg
}

view Button(props ButtonProps) {
	<button
		data-part="button"
		data-variant={ dom.Str(props.Variant) }
		type={ dom.StrOr(props.Type, "button") }
		disabled={ props.Disabled != nil && *props.Disabled }
		aria-label={ dom.Str(props.AriaLabel) }
		onclick={ props.Onclick }
	>{ props.Children }</button>
}
