package ui

import (
	"github.com/metruzanca/gothic"
	"github.com/metruzanca/gothic/dom"
)

type AccordionProps struct {
	gothic.Children
}

type AccordionItemProps struct {
	gothic.Children
	Open bool
}

type AccordionTriggerProps struct {
	gothic.Children
	ID       string
	Controls *string
	Expanded bool
	Onclick  gothic.Msg
}

type AccordionPanelProps struct {
	gothic.Children
	ID         string
	LabelledBy *string
	Expanded   bool
}

view Accordion(props AccordionProps) {
	<div data-part="accordion">{ props.Children }</div>
}

view AccordionItem(props AccordionItemProps) {
	<div data-part="accordion-item" data-open={ dom.If(props.Open, "true", "") }>{ props.Children }</div>
}

view AccordionTrigger(props AccordionTriggerProps) {
	<button
		data-part="accordion-trigger"
		data-expanded={ dom.If(props.Expanded, "true", "") }
		type="button"
		id={ props.ID }
		aria-expanded={ dom.If(props.Expanded, "true", "false") }
		aria-controls={ dom.Str(props.Controls) }
		onclick={ props.Onclick }
	>{ props.Children }</button>
}

view AccordionPanel(props AccordionPanelProps) {
	<div
		data-part="accordion-panel"
		role="region"
		id={ props.ID }
		aria-labelledby={ dom.Str(props.LabelledBy) }
		hidden={ !props.Expanded }
	>{ props.Children }</div>
}
