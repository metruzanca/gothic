package ui

import (
	"github.com/metruzanca/gothic"
	"github.com/metruzanca/gothic/dom"
)

type SwitchProps struct {
	gothic.Children
	ID       string
	Checked  bool
	Name     *string
	Value    *string
	Disabled *bool
	Required *bool
	Onchange gothic.Msg
}

view Switch(props SwitchProps) {
	<label
		data-part="switch"
		data-checked={ dom.If(props.Checked, "true", "") }
		data-disabled={ dom.If(props.Disabled != nil && *props.Disabled, "true", "") }
	>
		<input
			data-part="switch-input"
			type="checkbox"
			role="switch"
			id={ props.ID }
			name={ dom.Str(props.Name) }
			value={ dom.Str(props.Value) }
			checked={ props.Checked }
			disabled={ props.Disabled != nil && *props.Disabled }
			required={ props.Required != nil && *props.Required }
			onchange={ props.Onchange }
		/>
		<span data-part="switch-indicator" aria-hidden="true"></span>
		<span data-part="switch-label">{ props.Children }</span>
	</label>
}
