{
  "package": "github.com/metruzanca/gothic/ui",
  "alias": "ui",
  "module": "/_gothic/modules/ui_gothic.js",
  "components": [
    {
      "name": "Accordion",
      "go": "Accordion",
      "mount": "mountAccordion",
      "create": "createAccordion",
      "props": [
        {
          "name": "items",
          "type": "[]AccordionItem"
        }
      ],
      "listable": false
    },
    {
      "name": "Counter",
      "go": "Counter",
      "mount": "mountCounter",
      "create": "createCounter",
      "props": [
        {
          "name": "label",
          "type": "string"
        }
      ],
      "listable": true
    },
    {
      "name": "Tabs",
      "go": "Tabs",
      "mount": "mountTabs",
      "create": "createTabs",
      "props": [
        {
          "name": "items",
          "type": "[]Tab"
        }
      ],
      "listable": false
    }
  ]
